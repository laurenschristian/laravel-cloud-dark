{
  "manifest_version": 3,
  "name": "Laravel Cloud Dark",
  "version": "1.7.0",
  "description": "Dark mode, a light/dark/system switch and a cleaner dashboard for Laravel Cloud.",
  "content_scripts": [
    {
      "matches": [
        "https://cloud.laravel.com/*"
      ],
      "css": [
        "dark.css"
      ],
      "run_at": "document_start",
      "js": [
        "dark.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Laravel Cloud Dark"
  },
  "homepage_url": "https://github.com/laurenschristian/laravel-cloud-dark"
}
